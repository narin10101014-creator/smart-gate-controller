ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
FAMILY_PASSWORD=CHANGE_ME_FAMILY_PASSWORD

# Optional - how long a login session lasts. Defaults to 24h if unset.
# Format: a number followed by s (seconds), m (minutes), or h (hours) - e.g. 20s, 30m, 24h.
SESSION_TTL=24h

# Optional - login rate limit. Defaults to 5 attempts per 15m if unset.
LOGIN_RATE_LIMIT_WINDOW=2m
LOGIN_RATE_LIMIT_MAX=5

# Optional - where the SQLite database file lives. Defaults to ./data/gate.db
# (relative to backend/) for local dev. On Railway this should point at the
# mounted Volume path, e.g. /data/gate.db, so data survives redeploys.
DB_PATH=./data/gate.db