# Ignore dependency folders
node_modules/
backend/node_modules/
web/node_modules/

# Ignore build output
web/dist/
firmware/.pio/

# Ignore firmware secrets (real WiFi/backend credentials)
firmware/include/secrets.h

# Ignore machine-specific editor IntelliSense config (auto-generated, has local absolute paths)
.vscode/
firmware/.vscode/

# Ignore logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore local environment files
.env
